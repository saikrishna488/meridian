{
  "name": "meridian-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI surfaces for the Meridian desktop shell",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p . --noEmit && node scripts/build.mjs",
    "check": "tsc -p . --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
