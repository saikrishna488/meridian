<?xml version="1.0"?>
<!--
  labwc configuration for a Meridian session (see docs/adr/0002-compositor.md).
  The compositor stays generic: Meridian-specific behaviour is bound to
  fixed shell actions via `gapplication action org.meridian.Shell <name>`.
-->
<labwc_config>
  <core>
    <gap>0</gap>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <name>Meridian</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font>
      <name>Inter</name>
      <size>10</size>
      <weight>Medium</weight>
    </font>
  </theme>

  <!-- M0 running-app switcher (Alt+Tab), text only: app name + window title.
       Replaced by Meridian's own switcher in M1. -->
  <windowSwitcher preview="yes" outlines="yes" unshade="yes">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="70%" />
    </fields>
  </windowSwitcher>

  <keyboard>
    <!-- Keep labwc's standard bindings (Alt+Tab, Alt+F4, …). -->
    <default />

    <!-- Applications menu: tap Super. Options: Super+C. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="gapplication action org.meridian.Shell toggle-applications" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="gapplication action org.meridian.Shell toggle-applications" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="gapplication action org.meridian.Shell toggle-options" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="gapplication action org.meridian.Shell lock-session" />
    </keybind>

    <!-- Fallbacks for nested development, where the host desktop usually
         grabs Super. -->
    <keybind key="C-A-h">
      <action name="Execute" command="gapplication action org.meridian.Shell toggle-applications" />
    </keybind>
    <keybind key="C-A-c">
      <action name="Execute" command="gapplication action org.meridian.Shell toggle-options" />
    </keybind>
    <keybind key="C-A-l">
      <action name="Execute" command="gapplication action org.meridian.Shell lock-session" />
    </keybind>

    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Log out (ends the session, back to the login screen). -->
    <keybind key="W-S-q">
      <action name="Exit" />
    </keybind>
    <keybind key="C-A-BackSpace">
      <action name="Exit" />
    </keybind>
  </keyboard>
</labwc_config>
