#!/bin/sh
# labwc has now set WAYLAND_DISPLAY and DISPLAY. Import them here, rather
# than before the compositor starts, so activated portals can open a display.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
fi

# Supply graphical PolicyKit authentication for Settings and package operations.
for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# The idle client is scoped to this compositor and exits when it disconnects.
sh "$(dirname -- "$0")/idle" &

# Launch XDG login applications once per compositor session. Nested development
# sessions do not start another copy of the user's background applications.
if [ "${MERIDIAN_DEV:-0}" != 1 ]; then
    "${MERIDIAN_SHELL:-meridian-shell}" --autostart &
fi
